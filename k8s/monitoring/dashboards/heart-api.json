    {
      "id": 11,
      "type": "stat",
      "title": "Model version serving",
      "description": "From the model_info gauge exposed by each pod",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (version, model) (model_info)",
          "legendFormat": "{{model}} \u00b7 v{{version}}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name"
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Model behaviour",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
