      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Mean predicted P(disease) \u2014 drift signal",
      "description": "A sustained shift suggests the incoming patient population has changed",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(prediction_probability_disease_sum{job=\"heart-api\"}[5m])) / clamp_min(sum(rate(prediction_probability_disease_count{job=\"heart-api\"}[5m])), 1e-9)",
          "legendFormat": "mean P(disease)",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
