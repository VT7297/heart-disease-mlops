          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"heart-api\", path=\"/predict\"}[5m])))",
          "legendFormat": "p99",
          "instant": false,
          "range": true,
          "format": "time_series",
